# Copy this file to .env.local and fill in your token for local scans:
#   cp .env.example .env.local
# .env.local is gitignored, so your token never gets committed.

# Travelpayouts / Aviasales API token (REQUIRED for the scanner).
# Get one free at https://www.travelpayouts.com -> Profile -> API tokens.
TRAVELPAYOUTS_TOKEN=

# Your affiliate marker (optional). When set, booking links carry your partner
# id so you earn commission on bookings. Find it in the Travelpayouts dashboard.
TRAVELPAYOUTS_MARKER=

# Price currency (optional, defaults to usd). e.g. usd, eur, gbp.
TRAVELPAYOUTS_CURRENCY=usd
